<!-- Add inside /var/ossec/etc/ossec.conf, then: sudo systemctl restart wazuh-manager -->
<!-- Replace SHUFFLE_IP and the webhook ID. Never commit your real webhook URL. -->
<integration>
  <name>shuffle</name>
  <hook_url>http://SHUFFLE_IP:3001/api/v1/hooks/webhook_REPLACE_ME</hook_url>
  <!-- Lab used level 3 (very noisy). Prefer filtering by rule ID: -->
  <rule_id>100002,100003</rule_id>
  <alert_format>json</alert_format>
</integration>
